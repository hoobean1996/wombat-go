{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ui && npm ci --no-audit --no-fund && npm run build",
  "outputDirectory": "ui/dist",
  "functions": {
    "api/index.go": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/files/(.*)", "destination": "/api/index" },
    { "source": "/metrics", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/tick?advance=true", "schedule": "* * * * *" }
  ]
}
